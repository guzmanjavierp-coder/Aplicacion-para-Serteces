@startuml
class Categoria
class Equipo
class Mantenimiento
class Reparacion
class TipoCombustible
class MovimientoCombustible
class GestionCategorias
class GestionEquipos
class GestionMantenimientos
class GestionReparaciones
class GestionTiposCombustible
class GestionCombustible
